import { Estilo } from "LoginStyle.slint";

export struct Trazo {
    x1: float,
    y1: float,
    x2: float,
    y2: float,
}

component CampoTexto inherits VerticalLayout {
    in property <string> etiqueta;
    in property <bool> oculto: false;
    in-out property <string> valor;
    callback editado(string);
    callback aceptado();

    property <bool> mostrar-clave: false;

    public function enfocar() {
        entrada.focus();
    }

    spacing: 6px;

    Text {
        text: root.etiqueta;
        color: Estilo.texto-suave;
        font-size: 12px;
    }

    Rectangle {
        height: 42px;
        border-radius: Estilo.radio;
        background: Estilo.campo;
        border-width: 1px;
        border-color: entrada.has-focus ? Estilo.viento : Estilo.borde;
        animate border-color { duration: 200ms; }

        entrada := TextInput {
            x: 12px;
            width: parent.width - (root.oculto ? 52px : 24px);
            height: parent.height;
            vertical-alignment: center;
            color: Estilo.marfil;
            font-size: 14px;
            single-line: true;
            input-type: root.oculto && !root.mostrar-clave ? InputType.password : InputType.text;
            text <=> root.valor;
            edited => {
                root.editado(self.text);
            }
            accepted => {
                root.aceptado();
            }
        }

        if root.oculto : Rectangle {
            x: parent.width - self.width - 6px;
            width: 32px;
            height: 32px;
            border-radius: Estilo.radio;
            background: area-ojo.has-hover ? Estilo.borde.transparentize(0.6) : transparent;
            animate background { duration: 150ms; }

            Path {
                width: 20px;
                height: 20px;
                viewbox-width: 24;
                viewbox-height: 24;
                stroke: root.mostrar-clave ? Estilo.viento : Estilo.texto-suave;
                stroke-width: 1.5px;
                commands: "M 2 12 C 5 6 9 4 12 4 C 15 4 19 6 22 12 C 19 18 15 20 12 20 C 9 20 5 18 2 12 Z M 15 12 A 3 3 0 1 1 9 12 A 3 3 0 1 1 15 12 Z";
                animate stroke { duration: 150ms; }
            }

            if !root.mostrar-clave : Path {
                width: 20px;
                height: 20px;
                viewbox-width: 24;
                viewbox-height: 24;
                stroke: Estilo.texto-suave;
                stroke-width: 1.5px;
                commands: "M 4 4 L 20 20";
            }

            area-ojo := TouchArea {
                mouse-cursor: MouseCursor.pointer;
                clicked => {
                    root.mostrar-clave = !root.mostrar-clave;
                    entrada.focus();
                }
            }
        }
    }
}

component BotonPrincipal inherits Rectangle {
    in property <string> texto;
    in property <bool> habilitado: true;
    callback pulsado();

    height: 44px;
    border-radius: Estilo.radio;
    background: !root.habilitado ? Estilo.borde : area.pressed ? Estilo.oro.darker(0.15) : area.has-hover ? Estilo.oro.brighter(0.1) : Estilo.oro;
    animate background { duration: 150ms; }

    Text {
        text: root.texto;
        color: root.habilitado ? Estilo.tinta : Estilo.texto-suave;
        font-size: 14px;
        letter-spacing: 3px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    area := TouchArea {
        enabled: root.habilitado;
        mouse-cursor: root.habilitado ? MouseCursor.pointer : MouseCursor.default;
        clicked => {
            root.pulsado();
        }
    }
}

component Semilla inherits Path {
    width: 14px;
    height: 14px;
    viewbox-width: 20;
    viewbox-height: 20;
    stroke: Estilo.semilla;
    stroke-width: 1px;
    commands: "M 10 20 L 10 10 M 10 10 L 4 4 M 10 10 L 16 4 M 10 10 L 10 1 M 10 10 L 2 9 M 10 10 L 18 9";
}

component RosaSigilo inherits Rectangle {
    in property <[Trazo]> trazos;
    in property <int> encendidos;
    in property <bool> completo;

    width: 320px;
    height: 320px;

    Rectangle {
        width: parent.width;
        height: parent.height;
        border-radius: self.width / 2;
        border-width: 1px;
        border-color: Estilo.borde;
    }

    Rectangle {
        width: parent.width * 0.88;
        height: self.width;
        border-radius: self.width / 2;
        border-width: 1.5px;
        border-color: Estilo.oro;
    }

    Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 240;
        viewbox-height: 240;
        fill: Estilo.rosa;
        stroke: Estilo.viento;
        stroke-width: 1px;
        commands: "M 188 52 L 128 114 L 120 120 L 126 110 Z M 188 188 L 126 130 L 120 120 L 128 126 Z M 52 188 L 112 126 L 120 120 L 114 130 Z M 52 52 L 114 110 L 120 120 L 112 114 Z";
    }

    Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 240;
        viewbox-height: 240;
        fill: Estilo.rosa;
        stroke: Estilo.oro;
        stroke-width: 1px;
        commands: "M 120 24 L 132 108 L 120 120 L 108 108 Z M 216 120 L 132 132 L 120 120 L 132 108 Z M 120 216 L 108 132 L 120 120 L 132 132 Z M 24 120 L 108 108 L 120 120 L 108 132 Z";
    }

    for t[i] in root.trazos : Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 240;
        viewbox-height: 240;
        commands: "M \{t.x1} \{t.y1} L \{t.x2} \{t.y2}";
        stroke: root.completo ? Estilo.oro : Estilo.semilla;
        stroke-width: 2.5px;
        opacity: i < root.encendidos ? 1 : 0.15;
        animate opacity { duration: 350ms; easing: ease-out; }
    }

    Rectangle {
        width: root.completo ? 24px : 18px;
        height: self.width;
        border-radius: self.width / 2;
        background: Estilo.oro;
        animate width { duration: 400ms; easing: ease-out; }
    }

    Rectangle {
        width: 8px;
        height: 8px;
        border-radius: 4px;
        background: Estilo.noche;
    }
}

export component LoginUi inherits Rectangle {
    in-out property <string> usuario;
    in-out property <string> contrasena;
    in property <string> mensaje-error;
    in property <bool> cargando;
    in property <[Trazo]> trazos;
    in property <int> encendidos;
    in property <bool> acceso-concedido;
    callback usuario-editado(string);
    callback contrasena-editada(string);
    callback iniciar-sesion(string, string);

    property <float> tiempo: animation-tick() / 1ms;

    background: Estilo.noche;

    Image {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        source: @image-url("../assets/Imglogo.png");
        image-fit: cover;
    }

    Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        background: Estilo.noche.transparentize(0.45);
    }

    Path {
        x: 0;
        y: 0;
        width: parent.width - Estilo.ancho-panel;
        height: parent.height;
        viewbox-width: 1000;
        viewbox-height: 600;
        stroke: Estilo.borde;
        stroke-width: 1px;
        opacity: 0.6;
        commands: "M 0 120 Q 250 60 500 140 T 1000 110 M 0 480 Q 250 420 500 500 T 1000 470";
    }

    Path {
        x: 0;
        y: 0;
        width: parent.width - Estilo.ancho-panel;
        height: parent.height;
        viewbox-width: 1000;
        viewbox-height: 600;
        stroke: Estilo.viento;
        stroke-width: 1.5px;
        opacity: 0.3 + 0.2 * Math.sin(root.tiempo * 0.02deg);
        commands: "M 0 250 C 200 180 320 360 520 280 S 820 200 1000 260 M 0 340 C 180 300 360 420 560 350";
    }

    for i in 18 : Semilla {
        property <float> fase: Math.mod(i * 0.37, 1.0);
        property <float> avance: Math.mod(root.tiempo / (14000 + Math.mod(i * 1733, 9000)) + self.fase, 1.0);
        x: -20px + self.avance * (root.width + 40px);
        y: root.height * Math.mod(i * 0.61, 0.9) + Math.sin(root.tiempo * 0.03deg + i * 40deg) * 18px;
        opacity: 0.45 + Math.mod(i * 0.23, 0.45);
    }

    Rectangle {
        x: 0;
        y: 0;
        width: parent.width - Estilo.ancho-panel;
        height: parent.height;

        VerticalLayout {
            alignment: center;
            spacing: 28px;

            HorizontalLayout {
                alignment: center;

                RosaSigilo {
                    trazos: root.trazos;
                    encendidos: root.encendidos;
                    completo: root.acceso-concedido;
                }
            }

            Text {
                text: "DONDE EL VIENTO ES LIBRE";
                color: Estilo.texto-suave;
                font-size: 13px;
                letter-spacing: 4px;
                horizontal-alignment: center;
            }
        }
    }

    Rectangle {
        x: parent.width - Estilo.ancho-panel;
        y: 0;
        width: Estilo.ancho-panel;
        height: parent.height;
        background: Estilo.panel.transparentize(0.08);

        Rectangle {
            x: 0;
            y: 0;
            width: 1px;
            height: parent.height;
            background: Estilo.oro.transparentize(0.5);
        }

        VerticalLayout {
            padding-left: 56px;
            padding-right: 56px;
            alignment: center;
            spacing: 18px;

            Text {
                text: "MITHYIA";
                color: Estilo.marfil;
                font-size: 34px;
                letter-spacing: 8px;
                horizontal-alignment: center;
            }

            HorizontalLayout {
                alignment: center;

                Rectangle {
                    width: 90px;
                    height: 1px;
                    background: Estilo.oro;
                }
            }

            Rectangle {
                height: 16px;
            }

            CampoTexto {
                etiqueta: "Usuario";
                valor <=> root.usuario;
                editado(texto) => {
                    root.usuario-editado(texto);
                }
                aceptado => {
                    campo-contrasena.enfocar();
                }
            }

            campo-contrasena := CampoTexto {
                etiqueta: "Contraseña";
                oculto: true;
                valor <=> root.contrasena;
                editado(texto) => {
                    root.contrasena-editada(texto);
                }
                aceptado => {
                    root.iniciar-sesion(root.usuario, root.contrasena);
                }
            }

            Text {
                text: root.mensaje-error;
                color: Estilo.error;
                font-size: 12px;
                wrap: word-wrap;
                visible: root.mensaje-error != "";
            }

            BotonPrincipal {
                texto: root.cargando ? "ENTRANDO…" : "ENTRAR";
                habilitado: !root.cargando && root.usuario != "" && root.contrasena != "";
                pulsado => {
                    root.iniciar-sesion(root.usuario, root.contrasena);
                }
            }
        }

        Text {
            x: 0;
            y: parent.height - 40px;
            width: parent.width;
            text: "© 2026 @Mitsnightw · Todos los derechos reservados";
            color: Estilo.texto-suave;
            font-size: 11px;
            letter-spacing: 1px;
            horizontal-alignment: center;
        }
    }
}